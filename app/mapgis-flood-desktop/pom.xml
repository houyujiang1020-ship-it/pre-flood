<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.mapgis.floodguard</groupId>
  <artifactId>mapgis-flood-desktop</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.13.4</junit.version>
    <mapgis.home>C:/Program Files/MapGIS 10/Program</mapgis.home>
    <javafx.version>17.0.16</javafx.version>
    <floodguard.build.directory>${project.basedir}/target</floodguard.build.directory>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.19.2</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <directory>${floodguard.build.directory}</directory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>mapgis-sdk</id>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
        <executions><execution><id>mapgis-source</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals>
          <configuration><sources><source>src/mapgis/java</source></sources></configuration>
        </execution><execution><id>mapgis-test-source</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals>
          <configuration><sources><source>src/mapgis-test/java</source></sources></configuration>
        </execution></executions>
      </plugin><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.1</version>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
          <finalName>mapgis-floodguard-plugin</finalName><createDependencyReducedPom>false</createDependencyReducedPom>
          <artifactSet><excludes><exclude>org.openjfx:*</exclude><exclude>com.zondy.mapgis:*</exclude></excludes></artifactSet>
        </configuration></execution></executions>
      </plugin></plugins></build>
      <dependencies>
        <dependency>
          <groupId>com.zondy.mapgis</groupId><artifactId>geoobjects</artifactId><version>10-local</version><scope>system</scope>
          <systemPath>${mapgis.home}/mapgis_geoobjects.jar</systemPath>
        </dependency>
        <dependency>
          <groupId>com.zondy.mapgis</groupId><artifactId>geodatabase</artifactId><version>10-local</version><scope>system</scope>
          <systemPath>${mapgis.home}/mapgis_geodatabase.jar</systemPath>
        </dependency>
        <dependency>
          <groupId>com.zondy.mapgis</groupId><artifactId>geoanalysis</artifactId><version>10-local</version><scope>system</scope>
          <systemPath>${mapgis.home}/mapgis_geoanalysis.jar</systemPath>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId><artifactId>javafx-web</artifactId><version>${javafx.version}</version>
        </dependency>
        <dependency>
          <groupId>com.zondy.mapgis</groupId><artifactId>pluginengine</artifactId><version>10-local</version><scope>system</scope>
          <systemPath>${mapgis.home}/mapgis_pluginengine.jar</systemPath>
        </dependency>
        <dependency>
          <groupId>com.zondy.mapgis</groupId><artifactId>geomap</artifactId><version>10-local</version><scope>system</scope>
          <systemPath>${mapgis.home}/mapgis_geomap.jar</systemPath>
        </dependency>
        <dependency>
          <groupId>com.zondy.mapgis</groupId><artifactId>ui-controls</artifactId><version>10-local</version><scope>system</scope>
          <systemPath>${mapgis.home}/mapgis_ui_controls.jar</systemPath>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
